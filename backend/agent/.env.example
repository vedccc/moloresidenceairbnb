# =============================================================================
# Molo Residence Voice Agent — environment variables
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit Cloud
# SHARED-WITH-CONVRSE: reuse the same LiveKit Cloud project / API creds as the
# Convrse agent. This Molo agent is a SEPARATE agent (own agent id in
# livekit.toml) inside that same project.
# -----------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Supabase — Molo project (NOT the Convrse project)
# The agent runs server-side and uses the SERVICE-ROLE key to read/write the
# Molo schema directly. There are NO edge functions in the Molo project.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://sejbqspfwsgxuaevjwcf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server-side service role key — never expose to a browser

# -----------------------------------------------------------------------------
# Google Vertex AI — for the Gemini Live realtime audio model
# SHARED-WITH-CONVRSE: the same GCP project / service account can be reused.
# Provide creds EITHER as a file path (GOOGLE_APPLICATION_CREDENTIALS) OR as a
# base64-encoded service-account JSON (GOOGLE_CREDENTIALS_B64) for cloud deploys.
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account JSON (local dev)
GOOGLE_CREDENTIALS_B64=           # OR base64-encoded service-account JSON (cloud deploy)

# -----------------------------------------------------------------------------
# KWHotel PMS — reservation lookups
# Per-property properties.kwhotel_hotel_id overrides KWHOTEL_HOTEL_ID below.
# -----------------------------------------------------------------------------
KWHOTEL_API_BASE=https://cloud.kwhotel.com/kwhotel   # integrations API base — confirm against Swagger
KWHOTEL_USER=
KWHOTEL_PASSWORD=
KWHOTEL_API_KEY=
KWHOTEL_HOTEL_ID=                 # default hotel id; overridden per-property when set

# -----------------------------------------------------------------------------
# Telephony / transfers
# -----------------------------------------------------------------------------
AGENT_TRANSFER_FALLBACK_PHONE=    # used if neither property.transfer_phone nor agent_settings.transfer_default_phone is set
SIP_TRUNK_ID=                     # Telnyx SIP trunk id in LiveKit Cloud, for outbound transfer dials

# -----------------------------------------------------------------------------
# SMS — Telnyx (texts guests their booking link). Replaced SMSAPI.
# -----------------------------------------------------------------------------
TELNYX_API_KEY=                   # Telnyx API key (Bearer)
TELNYX_FROM=                      # sender number in E.164, e.g. +48...  (the provisioned Poland number)
TELNYX_MESSAGING_PROFILE_ID=      # OR a messaging profile id (alternative to TELNYX_FROM); at least one required
